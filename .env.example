# Copy to .env for local work. In production, set these in the host's secret store.
# Never commit real values.

# --- App ---
APP_ENV=development                  # development | test | production
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-32-plus-random-bytes
SESSION_TTL_HOURS=72
LOG_LEVEL=INFO

# --- Database (PostgreSQL 16 in every environment) ---
DATABASE_URL=postgresql+psycopg://careerpath:change-me@localhost:5432/careerpath
POSTGRES_PASSWORD=change-me

# --- LLM: OpenRouter (OpenAI-compatible). Model IDs chosen at gate G1 ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Ordered lists, comma-separated: primary first, fallback from a different provider second
LLM_MODELS_FAST=
LLM_MODELS_SMART=
LLM_REQUIRE_PARAMETERS=true
LLM_APP_NAME=CareerPath

# --- LLM behavior ---
LLM_TIMEOUT_FAST_S=20
LLM_TIMEOUT_SMART_S=40
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=4
LLM_DAILY_CALLS_PER_USER=25
LLM_DAILY_BUDGET_USD=0.30
LLM_PRICE_INPUT_PER_1M_USD=0
LLM_PRICE_OUTPUT_PER_1M_USD=0

# --- Agent and matching ---
MAX_RESULTS=5
RUN_STALE_AFTER_S=300
MAX_RESUME_REVISIONS=2

# --- Ingestion (batch command only) ---
INGEST_SOURCE=
INGEST_MAX_LISTINGS=500
INGEST_DELAY_S=3
INGEST_USER_AGENT=CareerPathBot/0.1 (contact: team-email)

# --- Security ---
LOGIN_MAX_ATTEMPTS_PER_15M=10

# --- Testing only (startup refuses non-off values when APP_ENV=production) ---
FAULT_INJECTION=off                  # off | timeout | error
